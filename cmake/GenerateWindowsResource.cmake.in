# Generated by CMakeLists.txt (configure_file, @ONLY) and executed at BUILD time by
# `cmake -P`. It writes the Windows resource script from `assets/igi-editor.rc.in`
# with the version values taken from the repo-root `version` file.
#
# Why a build-time script instead of `configure_file` directly: a `configure_file`
# output is written only while CMake configures and carries no ninja rule, so
# deleting it -- a partial `rm -rf build/generated`, or a restored CI build cache
# that dropped it -- fails the build with
#
#     ninja: error: '.../generated/igi-editor.rc', needed by
#     '.../igi-editor.rc.res', missing and no known rule to make it
#
# and only `--reconfigure` recovers. Generating at build time makes the file
# self-healing while keeping the single source of truth (issue #44).
#
# `cmake -P` has no cache, so `-D` arguments are ignored in script mode; that is why
# the paths and versions below are baked in at configure time instead of passed on
# the command line.

# The SEARCH strings are assembled at run time from ${_at} so that configure_file
# does not substitute them; only the replacement values are substituted. Writing the
# placeholder literally on both sides would collapse each REPLACE into a no-op and
# leave the template's placeholder in the output.
set(_at "@")

file(READ "@IGI_EDITOR_RC_IN@" rc_contents)
string(REPLACE "${_at}IGI_EDITOR_ICON${_at}" "@IGI_EDITOR_ICON@" rc_contents "${rc_contents}")
string(REPLACE "${_at}IGI_EDITOR_VERSION_COMMA${_at}" "@IGI_EDITOR_VERSION_COMMA@" rc_contents "${rc_contents}")
string(REPLACE "${_at}IGI_EDITOR_VERSION${_at}" "@IGI_EDITOR_VERSION@" rc_contents "${rc_contents}")

if (rc_contents MATCHES "@[A-Za-z_]+@")
  message(FATAL_ERROR "Unsubstituted resource placeholder: ${CMAKE_MATCH_0}")
endif ()

get_filename_component(rc_dir "@IGI_EDITOR_RC_OUT@" DIRECTORY)
file(MAKE_DIRECTORY "${rc_dir}")
file(WRITE "@IGI_EDITOR_RC_OUT@" "${rc_contents}")

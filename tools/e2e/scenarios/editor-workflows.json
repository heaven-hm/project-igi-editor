{
  "schemaVersion": 1,
  "purpose": "Runnable all-level editor control and persistence workflows (Task 3). Pause-menu row and spinner coordinates are computed from igi::BuildPauseMenuLayout / BuildPauseMenuSpinner for the editor's 1536x864 client window: menu_left=538, menu_width=460, 15 collapsed rows at 38px pitch starting menu_top+90, menu_top=90. Row order follows source/app_input_mouse.cpp: 0=Resume 1=Mode 2=Collision 3=Font 4=Select Level 5=Auto Save 6=Logging 7=Log Level 8=Music 9=Lightmap 10=Calculate Lightmaps 11=Terrain Options 12=Reset 13=Save 14=Quit.",
  "viewport": { "width": 1536, "height": 864 },
  "pauseMenu": {
    "menuLeft": 538,
    "menuTop": 90,
    "menuWidth": 460,
    "menuCenterX": 768,
    "rowHeight": 38,
    "firstRowOffset": 90,
    "rowCentersY": [180, 218, 256, 294, 332, 370, 408, 446, 484, 522, 560, 598, 636, 674, 712]
  },
  "spinners": {
    "fontRow": { "row": 3, "y": 294, "toggleX": 700 },
    "autoSaveRow": { "row": 5, "y": 370, "toggleX": 700 },
    "logLevelRow": { "row": 7, "y": 446, "toggleX": 700 },
    "levelRow": { "row": 4, "y": 332, "plusX": 846 }
  },
  "scenarios": [
    {
      "name": "editor-pause-resume",
      "level": 1,
      "requiresMutation": false,
      "steps": [
        { "id": "launch", "type": "launch_editor", "level": 1 },
        { "id": "window", "type": "wait_for_window", "timeoutSeconds": 45 },
        { "id": "loaded", "type": "wait_for_log", "pattern": "\\[App\\] LoadLevel\\(\\) COMPLETE for level 1", "timeoutSeconds": 120 },
        { "id": "healthy", "type": "assert_process" },
        { "id": "open-pause", "type": "key", "key": "ESC" },
        { "id": "pause-settle", "type": "wait", "seconds": 0.5 },
        { "id": "pause-shot", "type": "screenshot", "name": "pause-open" },
        { "id": "pause-visible", "type": "assert_screenshot_color_ratio", "region": [538, 90, 460, 684], "rgb": [0, 255, 0], "tolerance": 60, "minRatio": 0.01 },
        { "id": "cursor-in-pause", "type": "assert_cursor_visible" },
        { "id": "resume-click", "type": "click", "x": 768, "y": 180 },
        { "id": "resume-settle", "type": "wait", "seconds": 0.5 },
        { "id": "cursor-after-resume", "type": "assert_cursor_hidden" },
        { "id": "close", "type": "close_editor" }
      ]
    },
    {

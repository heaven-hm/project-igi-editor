# =============================================================================
# Project IGI Editor — ignore rules
#
# Design rules (see issue #44):
#   * Build trees are matched by ANCHORED PATH, never by blanket extension, so a
#     new source or fixture file is never silently dropped from the repo.
#   * Blanket extension ignores for TEXT SOURCE categories (*.txt, *.py, *.ps1,
#     *.qsc, *.conf, *.zip, *.rc) were removed. They had silently excluded the
#     entire Python verification harness (`tools/host-tests/host_test_runner.py`,
#     `tools/igi-re-parity/tu-check.py`) from git, which would have broken the
#     build gate on a fresh clone.
#   * `bin/` is build output only; the old `bin/` … `!bin/` pair contradicted
#     itself and let generated fixtures show up as untracked files.
# =============================================================================

# --- Build trees (anchored at the repository root) ---------------------------
/bin/
/build/
/build-*/
/scratch/
/releases/
/.cache/

# --- Compiled artefacts: never source, wherever they appear -------------------
*.d
*.o
*.obj
*.lo
*.slo
*.gch
*.pch
*.a
*.la
*.lai
*.lib
*.so
*.dylib
*.dll
*.exe
*.i86
*.x86_64
*.ilk
*.pdb
*.exp
*.tlog
*.log
*.app
*.zip

# --- CMake -------------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
Testing/
_deps/
cmake_test_discovery_*.json
Makefile

# --- Visual Studio -----------------------------------------------------------
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
*.userosscache
*.sln.docstates
*.opendb
*.ncb
*.db
Debug/
Release/
x64/
x86/
vcbuild/

# --- VS Code -----------------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# --- OS files ----------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store

# --- Caches ------------------------------------------------------------------
__pycache__/
*.pyc
node_modules/
.npm/
.yarn/
.pnpm-store/

# --- Local/agent scratch (never part of the product) -------------------------
.agent
.agent/
.gemini/
.claude/
.antigravity
.antigravitycli
.commandcode
claude.md
cursor.md
agents.md
.env
.env.*

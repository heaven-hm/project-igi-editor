//
// Editor event keystroke bindings
//

// Test event
//SetEventBinding("TestEvent",                              "<Shift><F10>");
//SetEventBinding("TestEvent",                              "<Ctrl><F10>");

// Camera
SetEventBinding("CameraEnable",                             "<Alt>");
SetEventBinding("CameraMoveForward",                        "<Alt><Shift>");
SetEventBinding("CameraMoveBackward",                       "<Alt><Ctrl>");
// task-11 item 1: CameraAdjustRadius (<Alt><Space>) was removed — the editor has
// no radius adjuster; the only radius is the object-orbit distance, which
// BeginObjectOrbit derives and CameraResetRadius resets.
// task-11 item 2: CameraLookDown (<Ctrl><Home>) was removed — nothing read its
// config key and the mouse owns camera pitch.
// task-11 item 3: CameraStrafeFree (<Alt><Space>) was removed — it toggled a flag
// nothing read and printed "Strafe lock: ON/OFF", a state change that never
// happened. Strafing is unconditional (source/app_view.cpp:225-236).
SetEventBinding("CameraResetRadius",                        "<Shift><Home>");
SetEventBinding("CameraCopyPosition",                       "<Ctrl><P>");
SetEventBinding("CameraCopyOrientation",                    "<Ctrl><Shift><O>");
SetEventBinding("CameraSnapToObject",                       "<F11>");
SetEventBinding("CameraSnapToGround",                       "<Alt><F11>");
SetEventBinding("CameraStrafeLeft",                         "<Alt><Left>");
SetEventBinding("CameraStrafeRight",                        "<Alt><Right>");
// #48: CameraCopyPosition/CameraCopyOrientation are implemented — QED.doc,
// "General keystrokes": "Ctrl P  Copy camera position to clipboard". The editor
// copies viewer_.pos_ / viewer_.yaw_,pitch_,roll_ through the clipboard it
// already owns (source/app_input.cpp CameraCopyPosition/CameraCopyOrientation).
// Removed in #48 (no handler answers these event names):
//   CameraSnapToObjectWithRadius (<Shift><F11>) — redundant, NOT missing: the
//     wider-radius framing is already done by the F11 handler itself, which
//     reads the Shift modifier and returns before event dispatch
//     (source/app_input_keyboard.cpp:466-471).
//   CameraStrafe (<Alt><Shift><Space>) — strafing is the two continuous held
//     bindings CameraStrafeLeft/Right above; a bare "strafe" has no path.
// See docs/igi-re-parity/KEYBINDINGS.md.
                                                            
// Tasks                                                    
SetEventBinding("TaskMoveUp",                               "<Shift><PageUp>");
SetEventBinding("TaskMoveDown",                             "<Shift><PageDown>");
SetEventBinding("TaskMoveHigher",                           "<Ctrl><PageUp>");
SetEventBinding("TaskMoveLower",                            "<Ctrl><PageDown>");
SetEventBinding("TaskNew",                                  "<Insert>");
SetEventBinding("TaskNewFirstChild",                        "<Control><Insert>");
SetEventBinding("TaskNewCameraRelative",                    "<Shift><Insert>");
SetEventBinding("TaskCopy",                                 "<Ctrl><C>");
SetEventBinding("TaskCopyRecursive",                        "<Ctrl><Shift><C>");
SetEventBinding("TaskPaste",                                "<Ctrl><V>");
SetEventBinding("TaskSendEvent",                            "<Ctrl><E>");
SetEventBinding("TaskSendEventRecursive",                   "<Ctrl><Shift><E>");
SetEventBinding("TaskFind",                                 "<Ctrl><F>");
SetEventBinding("TaskFindTextInTask",                       "<Ctrl><Shift><X>");
SetEventBinding("TaskFindByTaskID",                         "<Ctrl><Shift><I>");
SetEventBinding("TaskFindByTaskNote",                       "<Ctrl><Shift><N>");
SetEventBinding("TaskFindAgain",                            "<Ctrl><Shift><F>");
SetEventBinding("TaskSetID",                                "<Ctrl><I>");
SetEventBinding("TaskRebuildTree",                          "<F5>");
SetEventBinding("TaskMakeTemplate",                         "<Ctrl><M>");
SetEventBinding("TaskSortChildren",                         "<Shift><F5>");

// Animtask — removed in #48. This editor has no animation-task timeline,
// keyframe recorder, playback sync or anim camera window, and IGI-RE (which
// decompiles IGI.exe only, never the QED editor) has no counterpart to define
// their behaviour, so the bindings were advertised but could never act. Removed:
//   AnimTaskIncreaseKeyframeInterpolation <F8>, AnimTaskDecreaseKeyframeInterpolation
//   <Shift><F8>, AnimTaskToggleCameraRelative <F6>, AnimTaskGoToCursor <Ctrl><G>,
//   AnimTaskToggleWindowHidden <Ctrl><Shift><H>, AnimTaskStartRecording <Ctrl><Q>,
//   AnimTaskGoToTop <Ctrl><R>, AnimTaskToggleSyncPlayback <Ctrl><Shift><S>.
// (F6 also collided with ToggleTaskNoteDisplay, and AnimTaskGoToTop's <Ctrl><R>
// was the same combo as TimerReset.) The AnimTask *playback speed* half of the
// retail table is implemented under the Timer names below — QED.doc documents
// F12 / Shift F12 as "Increment / Decrement AnimTask speed"; the keyframe
// *interpolation* half (F8 / Shift F8) has no keyframe editor here and stays
// removed. See docs/igi-re-parity/KEYBINDINGS.md.

// Timer — implemented in #48 against the editor's one playback clock. QED.doc,
// "General keystrokes": "Ctrl R  Reset timer", "Ctrl T  Timer Start / Stop",
// "F12 / Shift F12  Increment / Decrement AnimTask speed" — so the retail timer
// and the AnimTask speed are the same control. That clock is the selected
// object's igi::AnimPlayback (source/animation.h:184): `playing` is start/stop,
// `Reset()` rewinds, and `speed` is applied to the engine by
// AnimPlayback::SyncEngineFlags (source/runtime/anim_playback.cpp:147-151).
// The editor has no AnimTask timeline editor, so the timer drives the animation
// preview that the property editor's animation list already starts
// (App::ToggleAnimationForObject, source/app.cpp:4539).
SetEventBinding("TimerStartStop",                           "<Ctrl><T>");
SetEventBinding("TimerReset",                               "<Ctrl><R>");
SetEventBinding("TimerIncreaseSpeed",                       "<F12>");
SetEventBinding("TimerDecreaseSpeed",                       "<Shift><F12>");

// Manipulate object — the seven "Manipulate*" event names below were removed in
// #48 because object manipulation is not driven by the event table at all: the
// gesture reads live modifier state and held keys, so rebinding these names could
// never change it. The behaviour is implemented and unchanged:
//   drag the marker with LMB                -> app_input_mouse.cpp:846-852
//   Shift+LMB  = move in the view plane     -> app_view.cpp:686 (MoveXY)
//   Ctrl+LMB   = move in the vertical plane -> app_view.cpp:685,687 (MoveXZ)
//   S / O while dragging = snap ground / on top of the nearest object
//                                           -> app_input_mouse.cpp:333-336,
//                                              app_view.cpp:748-780
//   A / B / G while dragging = rotate alpha/beta/gamma
//                                           -> app_input_keyboard.cpp:1524-1526,
//                                              app_view.cpp:688-690,734-746
//   Space while dragging = reset orientation-> app_input_keyboard.cpp:1543-1545,
//                                              app_view.cpp:785-788
// The configurable keys for those are keyRotateAlpha/Beta/Gamma, keySnapGround,
// keySnapObject and keyResetOri in qedconfig.qsc (source/config.cpp:142-147).
// Removed: Manipulate, ManipulatePositionXY, ManipulatePositionXZ (2 lines),
// ManipulateOrientationAlpha/Beta/Gamma, ManipulateOrientationReset.
// ManipulatePositionSnapToGround/Object are kept: they have real handlers at
// source/app_input.cpp:399 and :417.
SetEventBinding("ManipulatePositionSnapToGround",           "<LeftMouseButton><S>");
SetEventBinding("ManipulatePositionSnapToObject",           "<LeftMouseButton><O>");

// Graph Node
SetEventBinding("ScaleGraphNode",                           "<LeftMouseButton><Decimal>");
SetEventBinding("ScaleGraphNodeHalfe",                      "<LeftMouseButton><Divide>");
SetEventBinding("ScaleGraphNodeDouble",                     "<LeftMouseButton><Multiply>");
SetEventBinding("CreateGraphNode",                          "<LeftMouseButton><Plus>");
SetEventBinding("DeleteGraphNode",                          "<LeftMouseButton><Minus>");
// Two-step link editing: select node A, press Alt++ to mark source,
// select node B, press Alt++ again to link them. Alt+- removes the same way.
SetEventBinding("AddGraphLink",                             "<Alt><Plus>");
SetEventBinding("RemoveGraphLink",                          "<Alt><Minus>");
// Toggle on-screen node ID labels for the graph overlay.
SetEventBinding("ToggleGraphNodeLabels",                    "<Alt><L>");
SetEventBinding("ShowGraphNodes",                           "<F7>");


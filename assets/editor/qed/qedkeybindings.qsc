SetEventBinding("ToggleTaskTypeView",                       "<Shift><F2>");
SetEventBinding("ToggleGame",                               "<F3>");
SetEventBinding("ToggleTaskNoteDisplay",                    "<F6>");
SetEventBinding("ToggleQEDRunEvent",                        "<F9>");

// Toggle objects in editor (Extreme Sports)
SetEventBinding("ToggleObjects",                            "<Ctrl><Shift><Z>");

// Add a missing model's loose .mef into the level .res (issue 2)
// task-11 item 4: this was <Ctrl><Shift><A>, the same combo as ToggleAutoSave
// (which keeps it, "A" for AutoSave), so whichever handler ran first swallowed
// the other. Moved to <Ctrl><Shift>M for "model".
SetEventBinding("AddModelToRes",                            "<Ctrl><Shift>M");

// Toggle magic-object spheres overlay
SetEventBinding("TaskMagicObjToggle",                       "<Shift><M>");

// Terrain sculpt brush controls (feature E)
SetEventBinding("TerrainBrushCycle",                        "<B>");
SetEventBinding("TerrainBrushRadiusDec",                    "<J>");
SetEventBinding("TerrainBrushRadiusInc",                    "<K>");
SetEventBinding("TerrainBrushStrengthDec",                  "<N>");
SetEventBinding("TerrainBrushStrengthInc",                  "<U>");

